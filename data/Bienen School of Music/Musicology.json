        "course_number": "400-0",
        "course_name": "Graduate Review of Music History",
        "course_reference_number": [
            "22173"
        ],
        "course_info": [
            {
                "section": "1",
                "course_name": "Graduate Review of Music History",
                "instructors": [
                    "Emily C. Hoyler O'Hare"
                ],
                "days": [
                    "Tuesday",
                    "Thursday"
                ],
                "start_time": "8:30AM",
                "end_time": "9:50AM"
            }
        ],
        "course_details": [
            {
                "Instructors": "Emily C. Hoyler O'Hare\nemilychoyler.ohare@northwestern.edu",
                "Meeting Info": "RCMA 1-180: Tues, Thurs 8:30AM - 9:50AM",
                "Overview of class": "This course will review the history of western art music with an overall aim of providing useful skills for the graduate careers and working lives of professional musicians. Beyond the goal of identifying and addressing students' areas of weakness in preparation for music-history comprehensive exams, our special focus will be the acquisition of pedagogy skills for the college-level teaching of music history, and most of the quarter's assignments (teaching demos, sample syllabi, etc.) will be designed to enhance students' experience in this area.",
                "Class Materials (Required)": "Richard Taruskin and Christopher Gibbs, The Oxford History of Western Music, College Edition, 2nd edition. Oxford University Press, 2018. ISBN: 9780190600228. Estimated cost from $57 for a rented digital copy from the publisher's website to $180 for a new print copy.",
                "Enrollment Requirements": "Enrollment Requirements: Reserved for Doctor of Music Students and PhD Composition students."
            }
        ]
    },
